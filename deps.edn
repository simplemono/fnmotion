;; The pure parts (fnmotion.core, timeline, captions) are cljc and need
;; nothing; the player needs Replicant in the browser.
{:paths ["src"]
 ;; Replicant as the git coordinate parts-cljs uses, so that an app with
 ;; both resolves one Replicant (tools.deps cannot compare git and maven).
 :deps {no.cjohansen/replicant
        {:git/url "https://github.com/cjohansen/replicant.git"
         :git/sha "a7202a4243e69f63117c1bd1e9cbadcad380c280"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
