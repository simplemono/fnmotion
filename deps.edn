;; The pure parts (fnmotion.core, timeline, captions) are cljc and need
;; nothing; the player needs Replicant in the browser.
{:paths ["src"]
 ;; Replicant as the git coordinate parts-cljs uses, so that an app with
 ;; both resolves one Replicant (tools.deps cannot compare git and maven).
 :deps {;; fnmotion.render and fnmotion.html on the JVM; babashka has them built in.
        babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}
        org.babashka/http-client {:mvn/version "0.4.25"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        hiccup/hiccup {:mvn/version "2.0.0"}
        no.cjohansen/replicant
        {:git/url "https://github.com/cjohansen/replicant.git"
         :git/sha "a7202a4243e69f63117c1bd1e9cbadcad380c280"}
        ;; fnmotion.rframes, the server-side player, needs rframes; the
        ;; pure parts do not.
        io.github.simplemono/rframes$server
        {:git/url "https://github.com/simplemono/rframes.git"
         :git/sha "a0812c6a7506d4986214e9aaa80ffa03f521867c"
         :deps/root "server"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
